# Using ubuntu 25.10 [replace with almalinux:9 if any issues]
# FROM ubuntu:25.10
# FROM ubuntu:22.04
# FROM ubuntu:24.04

FROM almalinux:9

# Install dependencies [note: flex, bison, byacc required for spines parser]
RUN dnf install -y \
    gcc \
    gcc-c++ \
    make \
    openssl-devel \
    flex \
    bison \
    git \
    groff \
    python3 \
    iproute \
    iputils \
    which \
    tar \
    gzip \
    && dnf clean all
