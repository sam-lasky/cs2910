# docker build -f Dockerfile.prime -t prime-img .
# docker run -it --name prime-dev prime-img bash

FROM almalinux:9

# Install dependencies
RUN dnf install -y \
    gcc gcc-c++ make openssl-devel \
    flex bison byacc git groff python3 \
    iproute iputils which tar gzip \
    && dnf clean all

# Clone repository
WORKDIR /root
RUN git clone https://github.com/sam444555/cs2910.git

# Build Spines
WORKDIR /root/cs2910/prime/spines
RUN chmod +x configure stdutil/configure libspread-util/configure \
    && chmod -R +x stdutil/buildtools libspread-util/buildtools
RUN ./configure \
    && make -C daemon parser \
    && make

# Generate Spines keys
WORKDIR /root/cs2910/prime/spines/daemon
RUN chmod +x gen_keys.sh && ./gen_keys.sh

# Prepare Prime dependencies
WORKDIR /root/cs2910/prime
RUN chmod +x stdutil/configure libspread-util/configure \
    OpenTC-1.1/TC-lib-1.0/configure \
    OpenTC-1.1/TC-lib-1.0/missing \
    && chmod -R +x stdutil/buildtools libspread-util/buildtools

# Build Prime
WORKDIR /root/cs2910/prime/src
RUN make clean && make

WORKDIR /root/cs2910
